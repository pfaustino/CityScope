# Copy to `.env` and paste keys after the agencies email them.
# Never commit `.env`.

# U.S. Census Data API (required for live ACS). Free.
# Signup: https://api.census.gov/data/key_signup.html
# Email must end in .com / .net / .org / .gov / .edu. Activate the link in the email.
CENSUS_API_KEY=

# NOAA Climate Data Online token (historical weather). Free.
# Request: https://www.ncdc.noaa.gov/cdo-web/token
# NWS forecast already works without this.
NOAA_CDO_TOKEN=

# EPA AirNow (optional; air quality). Free account.
# Request: https://docs.airnowapi.org/account/request/
AIRNOW_API_KEY=

# FBI Crime Data Explorer / CDE (api.data.gov). Free.
# Signup: https://api.data.gov/signup/
# Annual agency summaries (ORI CA0191200), not a live incident map.
DATA_GOV_API_KEY=
